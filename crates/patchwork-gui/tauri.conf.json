{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchwork",
  "identifier": "dev.patchwork.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Patchwork",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  }
}
