{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchwork",
  "identifier": "dev.patchwork.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Patchwork",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A universal mod manager",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "desktopTemplate": "linux/patchwork.desktop" },
      "rpm": { "desktopTemplate": "linux/patchwork.desktop" }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nxm"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0QUQ5QkVBQzU1MzY4MzUKUldRMWFGUEY2cHV0NUx5dXNJN1YrcVJoRUFqelBOc0hRSzBUUFIzUHQra0pJRXB2NmhGQWZaODMK",
      "endpoints": ["https://github.com/patchwork-mods/patchwork/releases/latest/download/latest.json"]
    }
  }
}
